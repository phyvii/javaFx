<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.example.StagesController"
      style="-fx-background-color: linear-gradient(to bottom right, #1a1a2e, #16213e, #0f3460);"
>
    <Label fx:id="welcomeLabel" text="scena "
           style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"
    />
   <Button fx:id="moveBack" mnemonicParsing="false" text="Button" onAction="#moveBack"
           style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14; -fx-cursor: hand;"/>
</VBox>
